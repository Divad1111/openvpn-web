# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS web-build
WORKDIR /src/frontend
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM golang:1.23-bookworm AS go-build
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev libargon2-1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY backend ./backend
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
      go build -trimpath -ldflags='-s -w' -o /out/manager ./backend/cmd/manager

FROM debian:bookworm-slim AS manager
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libsqlite3-0 libargon2-1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 vpnmgr && useradd -r -u 10001 -g 10001 vpnmgr \
    && install -d -m 0700 -o 10001 -g 10001 /data/manager \
    && install -d -m 0750 -o 10001 -g 10001 /app/web \
    && install -d -m 0770 -o 10001 -g 10001 /run/agent
COPY --from=go-build /out/manager /usr/local/bin/manager
COPY --from=web-build /src/frontend/dist/ /app/web/
USER 10001:10001
EXPOSE 9443/tcp
ENTRYPOINT ["/usr/local/bin/manager"]
