# syntax=docker/dockerfile:1
# Official Easy-RSA release archive pinned to its upstream v3.2.7 checksum.
FROM debian:bookworm-slim AS easyrsa-build
ARG EASYRSA_VERSION=3.2.7
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl coreutils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN set -eux; \
    curl -fsSL --retry 3 "https://github.com/OpenVPN/easy-rsa/releases/download/v${EASYRSA_VERSION}/EasyRSA-${EASYRSA_VERSION}.tgz" -o easy-rsa.tgz; \
    echo '7ea8d5a3bbf3f20ca55b7728ea1ca7ea6335de1f77ba3632ce50110f36831f3875ebc58eb0759aee5af8245d06848036090d51cf284fdc6d4c0c66a4d072ae89  easy-rsa.tgz' | sha512sum -c -; \
    mkdir -p /out/easy-rsa; tar -xzf easy-rsa.tgz --strip-components=1 -C /out/easy-rsa; \
    test -f /out/easy-rsa/easyrsa

FROM golang:1.23-bookworm AS go-build
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev libargon2-1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY agent ./agent
COPY recovery ./recovery
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
      go build -trimpath -ldflags='-s -w' -o /out/control-agent ./agent/cmd/control-agent \
    && CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/recover ./recovery/cmd/recover

FROM debian:bookworm-slim AS agent
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates openssl libsqlite3-0 libargon2-1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 vpnmgr && useradd -r -u 10001 -g 10001 vpnmgr \
    && install -d -m 0770 -o 10001 -g 10001 /run/agent \
    && install -d -m 0770 -o 10001 -g 10001 /run/runtime \
    && install -d -m 0700 -o 10001 -g 10001 /data/agent \
    && install -d -m 0700 -o 10001 -g 10001 /data/export \
    && install -d -m 0750 -o 10001 -g 10001 /data/runtime-config
COPY --from=easyrsa-build /out/easy-rsa/ /opt/easy-rsa/
COPY --from=go-build /out/control-agent /usr/local/bin/control-agent
COPY --from=go-build /out/recover /usr/local/bin/recover
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/control-agent"]
