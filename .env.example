# Only exact lowercase 'true' enables the Docker-side write permission ceiling.
# In Phase 0 there are no mutation endpoints, even if true.
OPENVPN_MANAGER_WRITE_ENABLED=false

# Loopback is deliberate: for remote LAN access, explicitly specify NAS LAN IPv4.
MANAGER_BIND_IP=127.0.0.1
MANAGER_HTTPS_PORT=9443

# Client TCP listener mapping; do not change this from the Web UI.
OPENVPN_TCP_PORT=1194
